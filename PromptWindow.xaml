<ui:FluentWindow x:Class="WorkTimeTracker.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Time Check-in • 30m Log"
        Height="540" Width="560"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FocusManager.FocusedElement="{Binding ElementName=DescriptionBox}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Window TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Time Check-in" ShowMaximize="False" ShowMinimize="False" />

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,8,24,12">
            <StackPanel>
                
                <!-- Header Banner -->
                <ui:Card Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1B3A57" Margin="0,0,14,0">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="24" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="30-MINUTE INTERVAL COMPLETED" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                            <TextBlock Text="What have you been working on?" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Quick Category Shortcuts -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Quick Select Category:" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,2,0,0">
                        <ui:Button Content="💻 Coding" Margin="0,0,6,6" Click="OnCategoryChipClick" Tag="Feature Development &amp; Coding" Padding="10,5" Appearance="Secondary" />
                        <ui:Button Content="🚨 Prod Incident" Margin="0,0,6,6" Click="OnCategoryChipClick" Tag="Production Incident &amp; Triage" Padding="10,5" Appearance="Secondary" />
                        <ui:Button Content="🎫 Support &amp; Monitoring" Margin="0,0,6,6" Click="OnCategoryChipClick" Tag="Prod Support &amp; Monitoring" Padding="10,5" Appearance="Secondary" />
                        <ui:Button Content="🐛 Bug Fixing" Margin="0,0,6,6" Click="OnCategoryChipClick" Tag="Bug Fixing &amp; Investigation" Padding="10,5" Appearance="Secondary" />
                        <ui:Button Content="🔍 Code Review" Margin="0,0,6,6" Click="OnCategoryChipClick" Tag="Code Review &amp; Pull Requests" Padding="10,5" Appearance="Secondary" />
                        <ui:Button Content="🚀 Release / Deploy" Margin="0,0,6,6" Click="OnCategoryChipClick" Tag="Deployments &amp; Releases" Padding="10,5" Appearance="Secondary" />
                        <ui:Button Content="👥 Sync / Meeting" Margin="0,0,6,6" Click="OnCategoryChipClick" Tag="Standups, Meetings &amp; Syncs" Padding="10,5" Appearance="Secondary" />
                    </WrapPanel>
                </StackPanel>

                <!-- Category ComboBox -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Selected Category" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6" />
                    <ComboBox x:Name="CategoryComboBox" IsEditable="True" Height="36" FontSize="14" />
                </StackPanel>

                <!-- Description / Notes -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Description / Notes (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6" />
                    <ui:TextBox x:Name="DescriptionBox"
                                Height="80"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                PlaceholderText="e.g. Investigated 500 error spike in payment webhook, or PR #348 review..."
                                FontSize="13" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2" Background="#161616" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Snooze 5 mins" Click="OnSnoozeClick" Appearance="Secondary" Padding="14,7" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Skip" Click="OnSkipClick" Appearance="Secondary" Padding="14,7" Margin="0,0,10,0" />
                    <ui:Button Content="Save 30 Minutes" Click="OnSaveClick" Appearance="Primary" IsDefault="True" FontWeight="SemiBold" Padding="18,7" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
