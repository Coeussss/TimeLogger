<ui:FluentWindow x:Class="WorkTimeTracker.EditLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Log Entry Editor"
        Height="510" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Log Entry Editor" ShowMaximize="False" ShowMinimize="False" />

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,12,24,12">
            <StackPanel>

                <!-- Header info -->
                <ui:Card Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="#1B3A57" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="20" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DialogTitleText" Text="ADD / EDIT TIME BLOCK" FontSize="11" FontWeight="Bold" Foreground="#888888" />
                            <TextBlock x:Name="DialogDateSubtitle" Text="For Monday, Sep 21, 2026" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Category -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6" />
                    <ComboBox x:Name="CategoryCombo" IsEditable="True" Height="36" FontSize="13" />
                </StackPanel>

                <!-- Time and Duration Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Time (HH:mm) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Time of Day (HH:mm)" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6" />
                        <ui:TextBox x:Name="TimeBox" Height="36" FontSize="13" PlaceholderText="e.g. 09:30 or 14:00" />
                    </StackPanel>

                    <!-- Duration -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Duration" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6" />
                        <ComboBox x:Name="DurationCombo" Height="36" FontSize="13">
                            <ComboBoxItem Content="30 Minutes (1 block)" Tag="30" IsSelected="True" />
                            <ComboBoxItem Content="15 Minutes" Tag="15" />
                            <ComboBoxItem Content="45 Minutes" Tag="45" />
                            <ComboBoxItem Content="1.0 Hour (2 blocks)" Tag="60" />
                            <ComboBoxItem Content="1.5 Hours (3 blocks)" Tag="90" />
                            <ComboBoxItem Content="2.0 Hours (4 blocks)" Tag="120" />
                            <ComboBoxItem Content="2.5 Hours (5 blocks)" Tag="150" />
                            <ComboBoxItem Content="3.0 Hours (6 blocks)" Tag="180" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Description / Notes -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Description / Ticket Notes" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6" />
                    <ui:TextBox x:Name="DescriptionBox"
                                Height="85"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                PlaceholderText="Task summary, ticket ID (e.g., PROD-1234), or investigation notes..."
                                FontSize="13" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#161616" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Cancel" Click="OnCancelClick" Appearance="Secondary" Padding="16,6" Margin="0,0,10,0" IsCancel="True" />
                    <ui:Button x:Name="BtnSave" Content="Save Entry" Click="OnSaveClick" Appearance="Primary" Padding="20,6" IsDefault="True" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
