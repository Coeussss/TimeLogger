<ui:FluentWindow x:Class="WorkTimeTracker.SyncSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Synchronization Settings"
        Height="560" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Synchronization Settings" ShowMaximize="False" ShowMinimize="False" />

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,10,24,10">
            <StackPanel>

                <!-- Header info -->
                <ui:Card Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="#1B3A57" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="CloudSync24" FontSize="20" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DATA SYNCHRONIZATION" FontSize="11" FontWeight="Bold" Foreground="#888888" />
                            <TextBlock Text="Sync Desktop &amp; Android Companion App" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Mode 1: Home Server (Docker) -->
                <ui:Card Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <RadioButton x:Name="RadioHomeServer" GroupName="SyncModeGroup" Checked="OnSyncModeChanged" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                <TextBlock Text="Home Server (Docker Backend)" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                                <Border Background="#107C41" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="Recommended" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <StackPanel x:Name="PanelHomeServer" Margin="24,12,0,0">
                            <TextBlock Text="Server URL (with port, e.g. 48291)" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtServerUrl" PlaceholderText="http://myhome.ddns.net:48291" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="API Key (configured in your server .env)" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtApiKey" PlaceholderText="your_secret_api_key" Height="34" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnTestServer" Content="Test Connection" Appearance="Secondary" Click="OnTestServerConnectionClick" Padding="12,5">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="PlugConnected24" Foreground="#4CC2FF" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <TextBlock x:Name="TxtTestStatus" Text="" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="300"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Mode 2: Google Drive / Cloud Folder -->
                <ui:Card Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <RadioButton x:Name="RadioGoogleDrive" GroupName="SyncModeGroup" Checked="OnSyncModeChanged" VerticalAlignment="Center">
                            <TextBlock Text="Google Drive / Local Cloud Folder" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" Margin="6,0,0,0" />
                        </RadioButton>

                        <StackPanel x:Name="PanelGoogleDrive" Margin="24,12,0,0">
                            <TextBlock Text="Shared Sync Folder Path" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtDriveFolder" IsReadOnly="True" Height="34" Margin="0,0,8,0"/>
                                <ui:Button Grid.Column="1" Content="Browse..." Click="OnBrowseFolderClick" Height="34" Padding="12,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Mode 3: Local Only -->
                <ui:Card Padding="16,14" Margin="0,0,0,8">
                    <RadioButton x:Name="RadioLocalOnly" GroupName="SyncModeGroup" Checked="OnSyncModeChanged" VerticalAlignment="Center">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Local Only (No Remote Sync)" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="Stores logs only on this computer in AppData." FontSize="11" Foreground="#777777" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="#181818" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="1" Content="Cancel" Appearance="Secondary" Width="90" Height="34" Margin="0,0,8,0" Click="OnCancelClick" />
                <ui:Button Grid.Column="2" Content="Save &amp; Sync" Appearance="Primary" Width="110" Height="34" Click="OnSaveClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
